<?xml version="1.0" encoding="UTF-8"?>
<!-- launchd agent for the AgentOS server (module M8). Installed by install.sh into
     ~/Library/LaunchAgents (per user, can capture the desktop) and loaded with launchctl. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.agentos.server</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/agentos</string>
    <string>server</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>AGENTOS_LISTEN</key><string>:7800</string>
    <key>PATH</key><string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key>
  <dict><key>SuccessfulExit</key><false/></dict>
  <key>ThrottleInterval</key><integer>5</integer>
  <key>StandardOutPath</key><string>/tmp/agentos.log</string>
  <key>StandardErrorPath</key><string>/tmp/agentos.log</string>
</dict>
</plist>
