{
  "version": 1,
  "stacks": [
    {
      "id": "linux-desktop",
      "name": "Linux 桌面",
      "name_en": "Linux desktop",
      "category": "base",
      "icon": "desktop",
      "color": "#0EA5E9",
      "languages": [
        "desktop"
      ],
      "description": "轻量 XFCE 桌面 + Xvfb/x11vnc（与 Agent OS 内嵌桌面兼容）。适合无图形界面的 Linux 虚拟电脑/SSH/容器。",
      "description_en": "Lightweight XFCE desktop plus Xvfb/x11vnc (compatible with Agent OS embedded desktop). For headless Linux VMs, SSH hosts, and containers.",
      "homepage": "https://www.xfce.org/",
      "sources": [
        "https://packages.debian.org/xfce4",
        "https://packages.debian.org/x11vnc",
        "https://github.com/LibVNC/x11vnc"
      ],
      "detect": {
        "posix": "command -v x11vnc >/dev/null && command -v Xvfb >/dev/null && (command -v startxfce4 >/dev/null || command -v xfce4-session >/dev/null || command -v fluxbox >/dev/null)",
        "windows": "Write-Host 'Windows 自带桌面'; exit 0"
      },
      "setup": {
        "linux": [
          "$SUDO apt-get update -y",
          "$SUDO apt-get install -y --no-install-recommends xfce4 xfce4-terminal xvfb x11vnc xterm xdotool dbus-x11 || $SUDO apt-get install -y --no-install-recommends fluxbox xvfb x11vnc xterm xdotool",
          "mkdir -p \"$HOME/.agentos/vdesk\"",
          "echo 'Linux 桌面组件已安装。打开环境「桌面」页签即可使用（Docker 无桌面镜像会自动启用按需虚拟桌面）。'"
        ],
        "alpine": [
          "$SUDO apk add --no-cache xfce4 xfce4-terminal xvfb x11vnc xterm xdotool dbus || $SUDO apk add --no-cache fluxbox xvfb x11vnc xterm xdotool",
          "mkdir -p \"$HOME/.agentos/vdesk\"",
          "echo 'Linux 桌面组件已安装。打开环境「桌面」页签即可使用（Docker 无桌面镜像会自动启用按需虚拟桌面）。'"
        ],
        "rhel": [
          "$SUDO dnf install -y @xfce-desktop-environment xorg-x11-server-Xvfb x11vnc xterm xdotool || $SUDO dnf install -y fluxbox xorg-x11-server-Xvfb x11vnc xterm xdotool",
          "mkdir -p \"$HOME/.agentos/vdesk\"",
          "echo 'Linux 桌面组件已安装。打开环境「桌面」页签即可使用（Docker 无桌面镜像会自动启用按需虚拟桌面）。'"
        ],
        "darwin": [
          "echo 'macOS 自带图形桌面。如需 X11 应用可: brew install --cask xquartz'",
          "command -v brew >/dev/null 2>&1 && brew list --cask xquartz >/dev/null 2>&1 || brew install --cask xquartz || true"
        ],
        "windows": [
          "Write-Host 'Windows 虚拟电脑已自带桌面。可用系统远程桌面 (mstsc) 或 Agent OS 桌面页签。'",
          "try { Set-ItemProperty -Path 'HKLM:\\System\\CurrentControlSet\\Control\\Terminal Server' -Name fDenyTSConnections -Value 0 -ErrorAction SilentlyContinue; Enable-NetFirewallRule -DisplayGroup 'Remote Desktop' -ErrorAction SilentlyContinue; Write-Host '已尝试启用远程桌面' } catch { Write-Host '跳过远程桌面启用（需管理员）' }"
        ]
      },
      "docker_image": "localhost/agentos-desktop:0.1.20",
      "env_vars": [],
      "notes": "默认 XFCE；若软件源无 XFCE 则回退 fluxbox。安装到 Docker 无桌面容器后自动启用 virtual_desktop，打开「桌面」页签即可使用 VNC。",
      "agent_templates": [
        {
          "id": "desktop-check",
          "name": "检查桌面组件",
          "name_en": "Check desktop packages",
          "command": [
            "sh",
            "-c",
            "command -v x11vnc; command -v Xvfb; command -v startxfce4 || command -v fluxbox; echo OK"
          ],
          "command_windows": [
            "powershell",
            "-NoProfile",
            "-Command",
            "Write-Host 'Windows desktop OK'"
          ],
          "env": {},
          "work_dir": "~"
        }
      ]
    },
    {
      "id": "openssh",
      "name": "OpenSSH 服务",
      "name_en": "OpenSSH server",
      "category": "base",
      "icon": "terminal",
      "color": "#22C55E",
      "languages": [
        "ssh"
      ],
      "description": "安装并启用 OpenSSH 服务，便于终端、文件与桌面隧道。默认允许密钥登录。",
      "description_en": "Install and enable OpenSSH server for terminal, files, and desktop tunnels. Key-based login preferred.",
      "homepage": "https://www.openssh.com/",
      "sources": [
        "https://packages.debian.org/openssh-server",
        "https://learn.microsoft.com/windows-server/administration/openssh/openssh_install_firstuse"
      ],
      "detect": {
        "posix": "{ command -v sshd >/dev/null || test -x /usr/sbin/sshd; } && (ss -ltn 2>/dev/null | grep -qE ':22([[:space:]]|$)' || netstat -ltn 2>/dev/null | grep -qE ':22([[:space:]]|$)' || pgrep -x sshd >/dev/null)",
        "windows": "Get-Service sshd -ErrorAction SilentlyContinue | Where-Object { $_.Status -eq 'Running' } | Out-Null; if (-not $?) { exit 1 }; 'OpenSSH running'"
      },
      "setup": {
        "linux": [
          "$SUDO apt-get update -y && $SUDO apt-get install -y --no-install-recommends openssh-server",
          "$SUDO mkdir -p /var/run/sshd /etc/ssh",
          "if [ ! -f /etc/ssh/ssh_host_rsa_key ] && [ ! -f /etc/ssh/ssh_host_ed25519_key ]; then $SUDO ssh-keygen -A; fi",
          "$SUDO systemctl enable --now ssh 2>/dev/null || $SUDO systemctl enable --now sshd 2>/dev/null || $SUDO service ssh start 2>/dev/null || $SUDO service sshd start 2>/dev/null || $SUDO /usr/sbin/sshd",
          "pgrep -x sshd >/dev/null || { echo 'sshd 未能启动' >&2; exit 1; }",
          "echo 'OpenSSH 已安装/启用。'"
        ],
        "alpine": [
          "$SUDO apk add --no-cache openssh",
          "$SUDO mkdir -p /var/run/sshd",
          "if [ ! -f /etc/ssh/ssh_host_rsa_key ] && [ ! -f /etc/ssh/ssh_host_ed25519_key ]; then $SUDO ssh-keygen -A; fi",
          "$SUDO rc-update add sshd default 2>/dev/null || true",
          "$SUDO service sshd start 2>/dev/null || $SUDO /usr/sbin/sshd",
          "pgrep -x sshd >/dev/null || { echo 'sshd 未能启动' >&2; exit 1; }",
          "echo 'OpenSSH 已安装/启用。'"
        ],
        "rhel": [
          "$SUDO dnf install -y openssh-server",
          "$SUDO systemctl enable --now sshd",
          "echo 'OpenSSH 已安装/启用。'"
        ],
        "darwin": [
          "echo 'macOS 可用系统设置 → 通用 → 共享 → 远程登录启用 SSH'",
          "sudo systemsetup -setremotelogin on 2>/dev/null || true"
        ],
        "windows": [
          "Install-Pkg 'Microsoft.OpenSSH.Beta' 'openssh'",
          "try { Start-Service sshd -ErrorAction SilentlyContinue; Set-Service -Name sshd -StartupType Automatic -ErrorAction SilentlyContinue } catch {}",
          "Write-Host 'OpenSSH 已安装/尝试启动'"
        ]
      },
      "docker_image": "linuxserver/openssh-server:latest",
      "env_vars": [],
      "agent_templates": [
        {
          "id": "ssh-check",
          "name": "检查 SSH",
          "name_en": "Check SSH",
          "command": [
            "sh",
            "-c",
            "command -v sshd; ss -ltn 2>/dev/null | grep ':22' || true; echo OK"
          ],
          "command_windows": [
            "powershell",
            "-NoProfile",
            "-Command",
            "Get-Service sshd | Format-List"
          ],
          "env": {},
          "work_dir": "~"
        }
      ]
    },
    {
      "id": "zh-locale",
      "name": "中文语言包 / 输入法",
      "name_en": "Chinese locale & IME",
      "category": "base",
      "icon": "lang",
      "color": "#F59E0B",
      "languages": [
        "locale"
      ],
      "description": "简体中文语言包、字体与 fcitx5/ibus 拼音输入法（桌面环境更完整）。",
      "description_en": "Simplified Chinese locale, fonts, and fcitx5/ibus Pinyin IME for a complete desktop experience.",
      "homepage": "https://fcitx-im.org/",
      "sources": [
        "https://packages.debian.org/language-pack-zh-hans",
        "https://fcitx-im.org/",
        "https://github.com/ibus/ibus"
      ],
      "detect": {
        "posix": "locale -a 2>/dev/null | grep -qi 'zh_CN' && (command -v fcitx5 >/dev/null || command -v fcitx >/dev/null || command -v ibus >/dev/null || fc-list :lang=zh 2>/dev/null | head -1 | grep -q .)",
        "windows": "Get-WinUserLanguageList | Where-Object { $_.LanguageTag -like 'zh*' } | Out-Null; if (-not $?) { exit 1 }; 'zh OK'"
      },
      "setup": {
        "linux": [
          "$SUDO apt-get update -y",
          "$SUDO apt-get install -y --no-install-recommends language-pack-zh-hans fonts-noto-cjk fonts-wqy-zenhei 2>/dev/null || $SUDO apt-get install -y --no-install-recommends fonts-noto-cjk || true",
          "$SUDO apt-get install -y --no-install-recommends fcitx5 fcitx5-chinese-addons fcitx5-frontend-gtk3 fcitx5-frontend-gtk4 2>/dev/null || $SUDO apt-get install -y --no-install-recommends ibus ibus-libpinyin || true",
          "$SUDO locale-gen zh_CN.UTF-8 2>/dev/null || true",
          "$SUDO update-locale LANG=zh_CN.UTF-8 2>/dev/null || true",
          "echo '中文语言包/输入法已安装（若桌面已运行请重新登录会话）。'"
        ],
        "alpine": [
          "$SUDO apk add --no-cache musl-locales font-noto-cjk fcitx5 fcitx5-chinese-addons 2>/dev/null || $SUDO apk add --no-cache font-noto-cjk",
          "echo '中文组件已安装。'"
        ],
        "rhel": [
          "$SUDO dnf install -y glibc-langpack-zh langpacks-zh_CN google-noto-sans-cjk-fonts 2>/dev/null || $SUDO dnf install -y langpacks-zh_CN",
          "$SUDO dnf install -y ibus ibus-libpinyin 2>/dev/null || true",
          "echo '中文语言包/输入法已安装。'"
        ],
        "darwin": [
          "echo '请在 系统设置 → 键盘 → 输入法 中添加「简体拼音」。'",
          "true"
        ],
        "windows": [
          "try { $list = Get-WinUserLanguageList; $zh = New-WinUserLanguageList zh-CN; Set-WinUserLanguageList ($zh + $list) -Force; Write-Host '已添加 zh-CN 语言' } catch { Write-Host '请在设置 → 时间和语言 中添加中文' }"
        ]
      },
      "docker_image": "ubuntu:24.04",
      "env_vars": [],
      "agent_templates": [
        {
          "id": "zh-check",
          "name": "检查中文环境",
          "name_en": "Check Chinese locale",
          "command": [
            "sh",
            "-c",
            "locale -a | grep -i zh || true; fc-list :lang=zh 2>/dev/null | head -3; echo OK"
          ],
          "command_windows": [
            "powershell",
            "-NoProfile",
            "-Command",
            "Get-WinUserLanguageList | Format-Table"
          ],
          "env": {},
          "work_dir": "~"
        }
      ]
    },
    {
      "id": "chromium",
      "name": "Chromium 浏览器",
      "name_en": "Chromium browser",
      "category": "base",
      "icon": "browser",
      "color": "#4285F4",
      "languages": [
        "browser"
      ],
      "description": "系统 Chromium 浏览器，供桌面环境浏览网页（与 Playwright 沙箱浏览器不同）。",
      "description_en": "System Chromium browser for desktop browsing (distinct from Playwright sandboxed browsers).",
      "homepage": "https://www.chromium.org/",
      "sources": [
        "https://packages.debian.org/chromium",
        "https://www.chromium.org/getting-involved/download-chromium/"
      ],
      "detect": {
        "posix": "command -v chromium >/dev/null || command -v chromium-browser >/dev/null || command -v google-chrome >/dev/null || command -v google-chrome-stable >/dev/null",
        "windows": "Get-Command chrome,msedge,chromium -ErrorAction SilentlyContinue | Select-Object -First 1 | Out-Null; if (-not $?) { $p=@(\"$env:ProgramFiles\\Google\\Chrome\\Application\\chrome.exe\",\"$env:ProgramFiles (x86)\\Microsoft\\Edge\\Application\\msedge.exe\"); if (-not ($p | Where-Object { Test-Path $_ })) { exit 1 } }; 'browser OK'"
      },
      "setup": {
        "linux": [
          "$SUDO apt-get update -y",
          "$SUDO apt-get install -y --no-install-recommends chromium 2>/dev/null || $SUDO apt-get install -y --no-install-recommends chromium-browser 2>/dev/null || $SUDO snap install chromium 2>/dev/null || { echo '请手动安装 Chromium' >&2; exit 1; }",
          "echo 'Chromium 已安装。'"
        ],
        "alpine": [
          "$SUDO apk add --no-cache chromium",
          "echo 'Chromium 已安装。'"
        ],
        "rhel": [
          "$SUDO dnf install -y chromium 2>/dev/null || $SUDO dnf install -y chromium-browser",
          "echo 'Chromium 已安装。'"
        ],
        "darwin": [
          "brew install --cask chromium || brew install --cask google-chrome"
        ],
        "windows": [
          "Install-Pkg 'Chromium.Chromium' 'chromium'"
        ]
      },
      "docker_image": "browserless/chrome:latest",
      "env_vars": [],
      "agent_templates": [
        {
          "id": "chromium-version",
          "name": "查看 Chromium 版本",
          "name_en": "Chromium version",
          "command": [
            "sh",
            "-c",
            "chromium --version 2>/dev/null || chromium-browser --version 2>/dev/null || google-chrome --version"
          ],
          "command_windows": [
            "powershell",
            "-NoProfile",
            "-Command",
            "Get-Command chrome,msedge -EA SilentlyContinue | Format-Table"
          ],
          "env": {},
          "work_dir": "~"
        }
      ]
    },
