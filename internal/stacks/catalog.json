      "sources": [
        "https://docs.browser-use.com/open-source/quickstart",
        "https://github.com/browser-use/browser-use",
        "https://playwright.dev/python/docs/browsers"
      ],
      "detect": {
        "posix": "\"$HOME/.agentos/venvs/browser-use/bin/python\" -c 'import importlib.metadata as m; print(\"browser-use\", m.version(\"browser-use\"))'",
        "windows": "& \"$env:USERPROFILE\\.agentos\\venvs\\browser-use\\Scripts\\python.exe\" -c \"import importlib.metadata as m; print(m.version('browser-use'))\""
      },
      "setup": {
        "linux": [
