          "uv pip install --python \"$HOME/.agentos/venvs/browser-use/bin/python\" -U browser-use playwright",
          "if [ \"$(id -u)\" = \"0\" ] || sudo -n true 2>/dev/null; then \"$HOME/.agentos/venvs/browser-use/bin/python\" -m playwright install --with-deps chromium; else echo \"警告：无 root/免密 sudo，跳过系统依赖安装\" >&2; \"$HOME/.agentos/venvs/browser-use/bin/python\" -m playwright install chromium; fi"
        ],
        "rhel": [
          "ensure_uv",
          "uv venv --allow-existing --python 3.12 \"$HOME/.agentos/venvs/browser-use\"",
          "uv pip install --python \"$HOME/.agentos/venvs/browser-use/bin/python\" -U browser-use playwright",
          "if [ \"$(id -u)\" = \"0\" ] || sudo -n true 2>/dev/null; then \"$HOME/.agentos/venvs/browser-use/bin/python\" -m playwright install --with-deps chromium; else echo \"警告：无 root/免密 sudo，跳过系统依赖安装\" >&2; \"$HOME/.agentos/venvs/browser-use/bin/python\" -m playwright install chromium; fi"
        ],
        "darwin": [
          "ensure_uv",
          "uv venv --allow-existing --python 3.12 \"$HOME/.agentos/venvs/browser-use\"",
          "uv pip install --python \"$HOME/.agentos/venvs/browser-use/bin/python\" -U browser-use playwright",
          "\"$HOME/.agentos/venvs/browser-use/bin/python\" -m playwright install chromium"
        ],
        "alpine": [
          "$SUDO apk add --no-cache chromium",
          "ensure_uv",
          "uv venv --allow-existing --python 3.12 \"$HOME/.agentos/venvs/browser-use\"",
          "uv pip install --python \"$HOME/.agentos/venvs/browser-use/bin/python\" -U browser-use"
        ],
        "windows": [
          "Ensure-Uv",
          "uv venv --allow-existing --python 3.12 \"$env:USERPROFILE\\.agentos\\venvs\\browser-use\"",
          "uv pip install --python \"$env:USERPROFILE\\.agentos\\venvs\\browser-use\\Scripts\\python.exe\" -U browser-use playwright",
          "& \"$env:USERPROFILE\\.agentos\\venvs\\browser-use\\Scripts\\python.exe\" -m playwright install chromium"
        ]
      },
